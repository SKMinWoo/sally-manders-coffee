{
  "name": "sally-manders-coffee",
  "version": "0.1.0",
  "private": true,
  "description": "Sally Mander's, a simulated coffee shop in South Austin that never closes.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"lib/**/*.test.ts\" \"server/**/*.test.ts\" \"app/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "sim:backfill": "tsx scripts/backfill.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "drizzle-orm": "0.45.4",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
