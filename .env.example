# Copy to .env.local for development. Never commit the real values.

# Neon Postgres, the pooled connection string (Neon console → Connect).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Sent by Vercel Cron as "Authorization: Bearer <CRON_SECRET>". Any long random string.
CRON_SECRET=

# Salt for hashing visitor IPs before rate limiting; the raw IP is never stored. Any long random string.
IP_HASH_SALT=
